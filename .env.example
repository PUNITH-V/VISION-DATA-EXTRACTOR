# ── OpenRouter ─────────────────────────────────────────────────────────────
# Required. Obtain from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional. Defaults to "openrouter/free".
# OPENROUTER_MODEL=openrouter/free

# ── FastAPI / CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Defaults to localhost:5500 (VS Code Live Server default).
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Maximum file upload size in bytes. Default: 10485760 (10 MB).
# UPLOAD_MAX_BYTES=10485760

# ── Storage ─────────────────────────────────────────────────────────────────
# Directories for per-user reports and ChromaDB data.
# Defaults to output/ and chroma_data/ inside the project root.
# REPORTS_BASE_DIR=/absolute/path/to/output
# CHROMA_BASE_DIR=/absolute/path/to/chroma_data

# ── Supabase authentication (Stage 3) ───────────────────────────────────────
# SUPABASE_URL: Your project URL.
# Find it at: Dashboard → Settings → API → "Project URL"
# Example: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# SUPABASE_JWT_SECRET: Required ONLY for accepting HS256 legacy tokens.
# Your project currently retains the HS256 key for unexpired token verification.
# Find it at: Dashboard → Settings → Authentication → JWT Settings → "JWT Secret"
# Once you revoke the legacy HS256 key, you may remove this variable.
# If absent, HS256 tokens will be rejected (fail-closed).
SUPABASE_JWT_SECRET=your_jwt_secret_from_dashboard

# AUTH_ENABLED: Set to "true" after SUPABASE_URL is configured.
# Defaults to "false" (Stage 2 mode — all protected endpoints return 503).
AUTH_ENABLED=false

# JWKS cache TTL in seconds. Keys are refreshed after this period or
# immediately on a key-ID miss. Default: 600 (10 minutes).
# JWKS_CACHE_TTL_SECONDS=600
